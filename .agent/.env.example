# Fimo — Environment Variables
# Copy file ini ke .env.local dan isi nilainya

# ============================================================
# SUPABASE
# Dapatkan dari: https://supabase.com/dashboard/project/[id]/settings/api
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Hanya untuk Edge Functions — JANGAN expose ke client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# CLAUDE AI (Anthropic)
# Dapatkan dari: https://console.anthropic.com/settings/keys
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# FIREBASE
# Dapatkan dari: Firebase Console → Project Settings → General
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# VAPID key untuk Web Push
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BG8...

# Firebase Admin (untuk server-side FCM) — base64 encoded service account JSON
FIREBASE_SERVICE_ACCOUNT_KEY=eyJ0eXBlIjoic2Vydm...

# ============================================================
# EMAIL (Resend)
# Dapatkan dari: https://resend.com/api-keys
# ============================================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@fimo.app

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://fimo.web.app
